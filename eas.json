{
  "cli": {    
    "version": ">= 1.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": false,
      "env": {
        "APP_ENV": "production",        
        "GOOGLE_MAPS_API_KEY": "AIzaSyA1..."
      }
    },
    "android-dev-apk": {
      "extends": "production",
      "developmentClient": false,
      "android": {
        "buildType": "apk"
      }
    },
    "android-prod-apk": {
      "extends": "production",
      "android": {
        "buildType": "apk"
      }
    },
    "android-prod-aab": {
      "extends": "production",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "ios-prod": {
      "extends": "production",
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": {
    "production": {}
  }
}
